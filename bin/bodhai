#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [ -f "${ROOT_DIR}/apps/api/.venv/bin/python" ]; then
    PYTHON_BIN="${ROOT_DIR}/apps/api/.venv/bin/python"
elif [ -f "${ROOT_DIR}/apps/api/.venv/Scripts/python.exe" ]; then
    PYTHON_BIN="${ROOT_DIR}/apps/api/.venv/Scripts/python.exe"
else
    PYTHON_BIN="python3"
fi

PYTHONPATH="${ROOT_DIR}/apps/api" exec "${PYTHON_BIN}" -m app.cli.main "$@"
