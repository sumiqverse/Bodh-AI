# BodhAI API Environment Configuration
# Copy this file to .env before starting the server. Never commit actual secrets.

APP_NAME=BodhAI API
APP_ENV=local
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database placeholder
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bodhai_dev

# JWT Secret placeholder (min 32 chars)
SECRET_KEY=placeholder_secret_key_minimum_32_characters_long
