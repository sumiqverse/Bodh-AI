# ==============================================================================
# BodhAI Environment: DEVELOPMENT (Local / Cloud Dev)
# ==============================================================================
# NOTE: Do not commit production credentials. This file provides development defaults.

NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
APP_ENV=development
DEBUG=true

# Networking & Ports
API_PORT=8000
WEB_PORT=3000
HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:8000

# Security & CORS
SECRET_KEY=dev-insecure-secret-key-change-in-production-1234567890
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CURRENT_CONSENT_VERSION=2026.1

# Databases & Cache (Local Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bodhai_dev
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
TUTOR_PER_USER_RATE_LIMIT=30
TUTOR_GLOBAL_RATE_LIMIT=1000

# AI Tutor & Grounding (Mock / Dev Provider)
TUTOR_LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
TUTOR_LLM_MODEL=gpt-4o-mini
TUTOR_EMBEDDING_MODEL=text-embedding-3-small
TUTOR_SIMILARITY_THRESHOLD=0.70
TUTOR_TOP_K=5
TUTOR_MONTHLY_BUDGET_USD=50.0

# Observability (Optional in Dev)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=

# Feature Flags & Operations
MAINTENANCE_MODE=false
DEMO_MODE=false
FEATURE_FLAGS=aiTutor,offlineMode,detailedDiagnostics,feedbackForm
