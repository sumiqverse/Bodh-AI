  "components": {
    "schemas": {
      "AttemptResponse": {
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid",
            "title": "Attempt Id"
          },
          "is_correct": {
            "type": "boolean",
            "title": "Is Correct"
          },
          "p_mastery_after": {
            "type": "number",
            "title": "P Mastery After",
            "description": "Updated Bayesian mastery probability [0.0 - 1.0]"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation",
            "description": "Step-by-step conceptual solution"
          },
          "is_duplicate": {
            "type": "boolean",
            "title": "Is Duplicate",
            "description": "Flag indicating if idempotency deduplicated this request",
            "default": false
          }
        },
        "type": "object",
        "required": ["attempt_id", "is_correct", "p_mastery_after", "explanation"],
        "title": "AttemptResponse",
        "description": "Evaluation result for a submitted attempt."
      },
      "AttemptSubmitRequest": {
        "properties": {
          "question_id": {
            "type": "string",
            "format": "uuid",
            "title": "Question Id"
          },
          "skill_id": {
            "type": "string",
            "format": "uuid",
            "title": "Skill Id"
          },
          "selected_answer": {
            "type": "string",
            "title": "Selected Answer",
            "description": "Answer identifier (e.g. 'B') or numeric string"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8,
            "title": "Idempotency Key",
            "description": "Client-generated unique UUID preventing duplicate submissions"
          },
          "time_spent_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Time Spent Ms",
            "description": "Time spent solving the question in milliseconds"
          },
          "client_timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Client Timestamp",
            "description": "Client-side UTC timestamp when completed"
          }
        },
        "type": "object",
        "required": [
          "question_id",
          "skill_id",
          "selected_answer",
          "idempotency_key",
          "time_spent_ms",
          "client_timestamp"
        ],
        "title": "AttemptSubmitRequest",
        "description": "Practice question response submission payload."
      },
      "ConsentCreateRequest": {
        "properties": {
          "scope": {
            "type": "string",
            "title": "Scope",
            "description": "Consent scope, e.g. 'diagnostic', 'learning', 'data_sharing', 'offline_sync'"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Policy version consented to",
            "default": "2024.1"
          },
          "guardian_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guardian Id",
            "description": "Guardian UUID if student is minor"
          }
        },
        "type": "object",
        "required": ["scope"],
        "title": "ConsentCreateRequest",
        "description": "Parental/student consent registration payload."
      },
      "ConsentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "student_id": {
            "type": "string",
            "format": "uuid",
            "title": "Student Id"
          },
          "scope": {
            "type": "string",
            "title": "Scope"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "is_granted": {
            "type": "boolean",
            "title": "Is Granted"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "revoked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          }
        },
        "type": "object",
        "required": ["id", "student_id", "scope", "version", "is_granted", "timestamp"],
        "title": "ConsentResponse",
        "description": "Consent status confirmation."
      },
      "CurriculumResponse": {
