    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Liveness Probe",
        "description": "Returns 200 OK if the FastAPI process is active and accepting requests.",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["System"],
        "summary": "Readiness Probe",
        "description": "Probes PostgreSQL and Redis connections to verify operational readiness.",
        "operationId": "get_ready_ready_get",
        "responses": {
          "200": {
            "description": "All backend dependencies are healthy and ready to serve traffic.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "One or more dependencies (PostgreSQL or Redis) are unavailable."
          }
        }
      }
    },
