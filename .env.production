# ==============================================================================
# BodhAI Environment: PRODUCTION (Live Pilot & General Availability)
# ==============================================================================
# All secrets MUST be injected from Cloud Secret Manager / GitHub Secrets.
# Never commit real credentials to source control.

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
APP_ENV=production
DEBUG=false

# Networking & Ports
API_PORT=8000
WEB_PORT=3000
HOST=0.0.0.0
NEXT_PUBLIC_API_URL=https://api.bodhai.org

# Security & CORS (High-entropy secret key >= 64 characters)
SECRET_KEY=MUST_BE_INJECTED_VIA_SECRET_MANAGER_MIN_64_CHAR_ENTROPY
ALLOWED_ORIGINS=https://bodhai.org,https://www.bodhai.org,https://admin.bodhai.org
CORS_ORIGINS=https://bodhai.org,https://www.bodhai.org,https://admin.bodhai.org
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CURRENT_CONSENT_VERSION=2026.1

# Databases & Cache (Supabase Managed Postgres with PgBouncer Connection Pooler)
DATABASE_URL=postgresql+asyncpg://bodhai_prod_user:INJECT_SECRET@db.supabase.co:6543/postgres?ssl=require
REDIS_URL=rediss://default:INJECT_REDIS_SECRET@managed-redis.cloud:6379/0

# Rate Limiting & Protection
RATE_LIMIT_PER_MINUTE=60
TUTOR_PER_USER_RATE_LIMIT=20
TUTOR_GLOBAL_RATE_LIMIT=500
TUTOR_CIRCUIT_BREAKER_THRESHOLD=3
TUTOR_CIRCUIT_BREAKER_RECOVERY_SEC=30
TUTOR_TIMEOUT_SECONDS=5.0

# AI Tutor & Grounding (Production LLM with strict cost quota)
TUTOR_LLM_PROVIDER=openai
OPENAI_API_KEY=INJECT_OPENAI_API_KEY
OPENAI_API_BASE=https://api.openai.com/v1
TUTOR_LLM_MODEL=gpt-4o-mini
TUTOR_EMBEDDING_MODEL=text-embedding-3-small
TUTOR_SIMILARITY_THRESHOLD=0.70
TUTOR_TOP_K=5
TUTOR_MONTHLY_BUDGET_USD=100.0
TUTOR_LOG_RETENTION_DAYS=90

# Observability (Sentry + OpenTelemetry)
SENTRY_DSN=https://prod_key@o0.ingest.sentry.io/production_project
SENTRY_TRACES_SAMPLE_RATE=0.10
SENTRY_PROFILES_SAMPLE_RATE=0.10
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.bodhai.org:4318

# Operations & Feature Flags
MAINTENANCE_MODE=false
DEMO_MODE=false
FEATURE_FLAGS=aiTutor,offlineMode,detailedDiagnostics,feedbackForm
