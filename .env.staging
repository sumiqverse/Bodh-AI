# ==============================================================================
# BodhAI Environment: STAGING (Pre-production / Verification)
# ==============================================================================
# Separate staging database, managed staging Redis, and staging Sentry DSN.
# Production-like constraints enforced.

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=staging
APP_ENV=staging
DEBUG=false

# Networking & Ports
API_PORT=8000
WEB_PORT=3000
HOST=0.0.0.0
NEXT_PUBLIC_API_URL=https://api-staging.bodhai.internal

# Security & CORS (Must be strong, non-default 32+ char secret)
SECRET_KEY=staging-sec-auth-98124971824-prod-ready-staging-key-do-not-leak
ALLOWED_ORIGINS=https://staging.bodhai.internal,https://admin-staging.bodhai.internal
CORS_ORIGINS=https://staging.bodhai.internal,https://admin-staging.bodhai.internal
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CURRENT_CONSENT_VERSION=2026.1

# Databases & Cache (Dedicated Staging Supabase / Postgres Instance with SSL)
DATABASE_URL=postgresql+asyncpg://bodhai_staging_user:stg_pwd_secure@postgres-staging.supabase.co:5432/bodhai_staging?ssl=require
REDIS_URL=rediss://default:stg_redis_pwd@staging-redis.managed.cloud:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
TUTOR_PER_USER_RATE_LIMIT=20
TUTOR_GLOBAL_RATE_LIMIT=500

# AI Tutor & Grounding (Real LLM with Staging budget cap)
TUTOR_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-staging-mock-or-actual-key-stored-in-secret-manager
OPENAI_API_BASE=https://api.openai.com/v1
TUTOR_LLM_MODEL=gpt-4o-mini
TUTOR_EMBEDDING_MODEL=text-embedding-3-small
TUTOR_SIMILARITY_THRESHOLD=0.70
TUTOR_TOP_K=5
TUTOR_MONTHLY_BUDGET_USD=25.0

# Observability
SENTRY_DSN=https://staging_key@o0.ingest.sentry.io/staging_project
SENTRY_TRACES_SAMPLE_RATE=0.25
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector-staging.bodhai.internal:4318

# Feature Flags & Operations
MAINTENANCE_MODE=false
DEMO_MODE=true
FEATURE_FLAGS=aiTutor,offlineMode,demoMode,detailedDiagnostics,feedbackForm
