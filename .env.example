# BodhAI Environment Template (Root)
# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
API_PORT=8000
WEB_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bodhai_dev
JWT_SECRET_KEY=example-secret-key-change-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local
